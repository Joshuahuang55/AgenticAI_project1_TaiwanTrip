# Copy to .env for local dev (never commit .env). On Cloud Run, set these as service env vars.
TDX_CLIENT_ID=your-tdx-client-id
TDX_CLIENT_SECRET=your-tdx-client-secret
CWA_API_KEY=your-cwa-api-key
# Optional: tool calls allowed per rolling minute, shared by all users (default 5).
# TOOL_CALLS_PER_MINUTE=5
